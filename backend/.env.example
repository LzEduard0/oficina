PORT=3001
DATABASE_URL="file:./dev.db"

# Access Token do Mercado Pago (obtenha em https://www.mercadopago.com.br/developers/panel)
# Use o token de TESTE durante o desenvolvimento e o de PRODUÇÃO apenas em produção.
MP_ACCESS_TOKEN=""

# URL pública do frontend, usada nas URLs de retorno (back_urls) do checkout do Mercado Pago
FRONTEND_URL="http://localhost:5173"

# URL pública do backend, usada para configurar o webhook de notificações do Mercado Pago
BACKEND_URL="http://localhost:3001"
